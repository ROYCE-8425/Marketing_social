# DX-OS Bootstrap Runtime Configuration Example
# Copy this file to .env for custom local settings.
# Required environment variables for local Docker Compose runs.
# NEVER commit real passwords, secrets, or tokens.

POSTGRES_DB=dxos
POSTGRES_USER=dxos
POSTGRES_PASSWORD=<set-a-secure-local-password>
POSTGRES_PORT=5432
API_PORT=8080

# ── AIECOS Social CRM (docker-compose.yml) ──
# Shared secret between Chrome extension and sync-receiver. Generate: openssl rand -hex 32
API_TOKEN=dev-token-change-me-in-prod
# Optional: point ingest at hosted Supabase instead of local PostgREST
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_SCHEMA=aiecos_social

# ── Facebook Lead Ads (Official Meta Graph API) ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_MODE=mock
PUBLIC_BASE_URL=

# ── Zalo Official Account (Official OpenAPI) ──
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET=
ZALO_MODE=mock

# ── TikTok for Business (Official Marketing API Lead Generation) ──
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ADVERTISER_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_MODE=mock

# ── Kimi / Moonshot (optional IChatClient). Empty = MockChatClient, clone/run without LLM.
# Never commit the real key. Global base: https://api.moonshot.ai/v1  China: https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

# ── Google Gemini (optional IChatClient, preferred when set). Free-tier Flash-Lite.
# Never commit the real key. AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
