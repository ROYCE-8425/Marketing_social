# DX-OS Bootstrap Runtime Configuration Example
# Copy this file to .env for custom local settings.
# Required environment variables for local Docker Compose runs.
# NEVER commit real passwords, secrets, or tokens.

POSTGRES_DB=dxos
POSTGRES_USER=dxos
POSTGRES_PASSWORD=<set-a-secure-local-password>
POSTGRES_PORT=5432
API_PORT=8080

# ── AIECOS Social CRM (docker-compose.yml) ──
# Shared secret between Chrome extension and sync-receiver. Generate: openssl rand -hex 32
API_TOKEN=dev-token-change-me-in-prod
# Optional: point ingest at hosted Supabase instead of local PostgREST
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_SCHEMA=aiecos_social

# ── Facebook Lead Ads (Official Meta Graph API) ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_MODE=mock
PUBLIC_BASE_URL=
